      "name": "X-BA Post Patient",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "const nombres = [\"Carolina\", \"Juana\", \"María\", \"Andrea\", \"Fabiana\",\"Martina\",\"Karen\",\"Belén\",\"Jesica\",\"Daniela\",\"Sabrina\"];\r",
              "const segundos = [\"Agustina\", \"Sofía\", \"Josefina\", \"Verónica\", \"Romina\", \"Elena\",\"Micaela\",\"Paula\",\"Paula\",\"Natalia\"];\r",
              "const apellidos = [\"Gómez\", \"Fernández\", \"Pérez\", \"López\", \"Martínez\", \"Rodríguez\",\"Rodriguez\"];\r",
              "const segundos_apellidos = [\"Nuñez\", \"Gauna\", \"Libertelli\", \"Vargas\", \"Martinez\", \"Herrera\",\"Vazquez\"];\r",
              "\r",
              "const idDominioLocal = [304012,304013,304014,304015,304016,304017,304018,304019,304020,304021,304022,304012,304023,304024,304025,304026,304027,304028,304029,304030,304031,304032,304033,304034,304035,304036]\r",
              "\r",
              "function elegirAleatorio(arr) {\r",
              "    return arr[Math.floor(Math.random() * arr.length)];\r",
              "}\r",
              "\r",
              "pm.environment.set(\"primer_nombre\", elegirAleatorio(nombres));\r",
              "pm.environment.set(\"segundo_nombre\", elegirAleatorio(segundos));\r",
              "pm.environment.set(\"primer_apellido\", elegirAleatorio(apellidos));\r",
              "pm.environment.set(\"segundo_apellido\", elegirAleatorio(segundos_apellidos));\r",
              "pm.environment.set(\"idDominioLocal\", elegirAleatorio(idDominioLocal))"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
