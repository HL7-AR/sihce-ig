           fhir:l fhir:string
         ]
       ] ) ;
       fhir:mapping ( [
         fhir:identity [ fhir:v "mlpersona-to-sihce" ] ;
         fhir:map [ fhir:v "Patient.identifier.where(type.coding.code = 'NI').value" ] ;
