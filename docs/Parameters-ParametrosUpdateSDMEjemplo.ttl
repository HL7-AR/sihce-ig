# - resource -------------------------------------------------------------------

<http://sihce.gob.ar/Parameters/ParametrosUpdateSDMEjemplo> a fhir:Parameters ;
  fhir:nodeRole fhir:treeRoot ;
  fhir:id [ fhir:v "ParametrosUpdateSDMEjemplo"] ; # 
  fhir:meta [
     fhir:profile ( [
       fhir:v "http://sihce.gob.ar/ImplementationGuide/SIHCE.fhir.core/StructureDefinition/parametros-update-sdm-sihce"^^xsd:anyURI ;
       fhir:l <http://sihce.gob.ar/ImplementationGuide/SIHCE.fhir.core/StructureDefinition/parametros-update-sdm-sihce>
     ] )
  ] ; # 
  fhir:parameter ( [
     fhir:name [ fhir:v "patient" ] ;
     fhir:Parameters.parameter.resource ( [
       a fhir:Patient ;
       fhir:id [ fhir:v "PersonaSIHCEMin" ] ;
       fhir:meta [
         fhir:profile ( [
           fhir:v "http://sihce.gob.ar/ImplementationGuide/SIHCE.fhir.core/StructureDefinition/PatientXBA"^^xsd:anyURI ;
           fhir:l <http://sihce.gob.ar/ImplementationGuide/SIHCE.fhir.core/StructureDefinition/PatientXBA>
         ] )
       ] ;
       fhir:identifier ( [
         fhir:use [ fhir:v "official" ] ;
         fhir:type [
           fhir:coding ( [
             fhir:system [
               fhir:v "http://terminology.hl7.org/CodeSystem/v2-0203"^^xsd:anyURI ;
               fhir:l <http://terminology.hl7.org/CodeSystem/v2-0203>
             ] ;
             fhir:code [ fhir:v "NI" ]
           ] )
         ] ;
         fhir:system [
           fhir:v "http://www.renaper.gob.ar/dni"^^xsd:anyURI ;
           fhir:l <http://www.renaper.gob.ar/dni>
         ] ;
         fhir:value [ fhir:v "12345678" ]
       ] [
         fhir:use [ fhir:v "secondary" ] ;
         fhir:type [
           fhir:coding ( [
             fhir:system [
               fhir:v "http://terminology.hl7.org/CodeSystem/v2-0203"^^xsd:anyURI ;
               fhir:l <http://terminology.hl7.org/CodeSystem/v2-0203>
             ] ;
             fhir:code [ fhir:v "MR" ]
           ] )
         ] ;
         fhir:system [
           fhir:v "http://hospitalitaliano.org.ar/fhir"^^xsd:anyURI ;
           fhir:l <http://hospitalitaliano.org.ar/fhir>
         ] ;
         fhir:value [ fhir:v "23" ]
       ] ) ;
       fhir:name ( [
         fhir:use [ fhir:v "official" ] ;
         fhir:text [ fhir:v "Carlos Pereira" ] ;
         fhir:family [ fhir:v "Pereira" ] ;
         fhir:given ( [ fhir:v "Carlos" ] )
       ] ) ;
       fhir:gender [ fhir:v "male" ] ;
       fhir:birthDate [ fhir:v "1939-12-20"^^xsd:date ]
     ] )
  ] ) . # 

