@prefix fhir: <http://hl7.org/fhir/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# - resource -------------------------------------------------------------------

<http://sihce.gob.ar/Patient/PersonaSIHCEPatch> a fhir:Patient ;
  fhir:nodeRole fhir:treeRoot ;
  fhir:id [ fhir:v "PersonaSIHCEPatch"] ; # 
  fhir:meta [
     fhir:profile ( [
       fhir:v "http://sihce.gob.ar/StructureDefinition/PatientXBA"^^xsd:anyURI ;
       fhir:l <http://sihce.gob.ar/StructureDefinition/PatientXBA>
     ] )
  ] ; # 
  fhir:text [
     fhir:status [ fhir:v "generated" ] ;
     fhir:div [ fhir:v "<div xmlns=\"http://www.w3.org/1999/xhtml\"><p>Ejemplo de paciente para operaciones de parcheo según PatientXBA.</p></div>"^^rdf:XMLLiteral ]
  ] ; # 
  fhir:identifier ( [
     fhir:use [ fhir:v "official" ] ;
     fhir:type [
       fhir:coding ( [
         fhir:system [
           fhir:v "http://terminology.hl7.org/CodeSystem/v2-0203"^^xsd:anyURI ;
           fhir:l <http://terminology.hl7.org/CodeSystem/v2-0203>
         ] ;
         fhir:code [ fhir:v "NI" ]
       ] )
     ] ;
     fhir:system [
       fhir:v "http://renaper.gob.ar/dni"^^xsd:anyURI ;
       fhir:l <http://renaper.gob.ar/dni>
     ] ;
     fhir:value [ fhir:v "12345678" ]
  ] [
     fhir:use [ fhir:v "secondary" ] ;
     fhir:type [
       fhir:coding ( [
         fhir:system [
           fhir:v "http://terminology.hl7.org/CodeSystem/v2-0203"^^xsd:anyURI ;
           fhir:l <http://terminology.hl7.org/CodeSystem/v2-0203>
         ] ;
         fhir:code [ fhir:v "MR" ]
       ] )
     ] ;
     fhir:system [
       fhir:v "http://hospitalitaliano.org.ar/fhir"^^xsd:anyURI ;
       fhir:l <http://hospitalitaliano.org.ar/fhir>
     ] ;
     fhir:value [ fhir:v "9876543210" ]
  ] ) ; # 
  fhir:name ( [
     fhir:use [ fhir:v "official" ] ;
     fhir:text [ fhir:v "Carlos Pereira" ] ;
     fhir:family [ fhir:v "Pereira" ] ;
     fhir:given ( [ fhir:v "Carlos" ] )
  ] ) ; # 
  fhir:gender [ fhir:v "male"] ; # 
  fhir:birthDate [ fhir:v "1939-12-20"^^xsd:date] . # 

