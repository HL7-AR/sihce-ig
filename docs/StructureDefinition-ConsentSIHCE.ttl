           fhir:link <http://hl7.org/fhir/StructureDefinition/Consent>
         ]
       ], [
         fhir:index 8 ;
         fhir:ElementDefinition.constraint.key [ fhir:value "ppc-4" ] ;
         fhir:ElementDefinition.constraint.severity [ fhir:value "error" ] ;
         fhir:ElementDefinition.constraint.human [ fhir:value "IF Scope=adr, there must be a patient" ] ;
         fhir:ElementDefinition.constraint.expression [ fhir:value "patient.exists() or scope.coding.where(system='something' and code='adr').exists().not()" ] ;
         fhir:ElementDefinition.constraint.xpath [ fhir:value "exists(f:patient) or not(exists(f:scope/f:coding[f:system/@value='something' and f:code/@value='adr'])))" ] ;
         fhir:ElementDefinition.constraint.source [
           fhir:value "http://hl7.org/fhir/StructureDefinition/Consent" ;
           fhir:link <http://hl7.org/fhir/StructureDefinition/Consent>
         ]
