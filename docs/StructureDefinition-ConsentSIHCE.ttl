         fhir:ElementDefinition.constraint.severity [ fhir:value "error" ] ;
         fhir:ElementDefinition.constraint.human [ fhir:value "IF Scope=research, there must be a patient" ] ;
         fhir:ElementDefinition.constraint.expression [ fhir:value "patient.exists() or scope.coding.where(system='something' and code='research').exists().not()" ] ;
         fhir:ElementDefinition.constraint.xpath [ fhir:value "exists(f:patient) or not(exists(f:scope/f:coding[f:system/@value='something' and f:code/@value='research'])))" ] ;
         fhir:ElementDefinition.constraint.source [
