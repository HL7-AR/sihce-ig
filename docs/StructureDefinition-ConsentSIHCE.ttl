         fhir:ElementDefinition.constraint.severity [ fhir:value "error" ] ;
         fhir:ElementDefinition.constraint.human [ fhir:value "Either a Policy or PolicyRule" ] ;
         fhir:ElementDefinition.constraint.expression [ fhir:value "policy.exists() or policyRule.exists()" ] ;
         fhir:ElementDefinition.constraint.xpath [ fhir:value "exists(f:policy) or exists(f:policyRule)" ] ;
         fhir:ElementDefinition.constraint.source [
           fhir:value "http://hl7.org/fhir/StructureDefinition/Consent" ;
           fhir:link <http://hl7.org/fhir/StructureDefinition/Consent>
         ]
       ], [
         fhir:index 6 ;
         fhir:ElementDefinition.constraint.key [ fhir:value "ppc-2" ] ;
         fhir:ElementDefinition.constraint.severity [ fhir:value "error" ] ;
         fhir:ElementDefinition.constraint.human [ fhir:value "IF Scope=privacy, there must be a patient" ] ;
         fhir:ElementDefinition.constraint.expression [ fhir:value "patient.exists() or scope.coding.where(system='something' and code='patient-privacy').exists().not()" ] ;
         fhir:ElementDefinition.constraint.xpath [ fhir:value "exists(f:patient) or not(exists(f:scope/f:coding[f:system/@value='something' and f:code/@value='patient-privacy'])))" ] ;
         fhir:ElementDefinition.constraint.source [
           fhir:value "http://hl7.org/fhir/StructureDefinition/Consent" ;
           fhir:link <http://hl7.org/fhir/StructureDefinition/Consent>
         ]
       ], [
