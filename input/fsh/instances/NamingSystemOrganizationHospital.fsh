Instance: NamingSystemOrganizationHospitalMsgc
InstanceOf: NamingSystem
Usage: #definition
Title: "NamingSystem Organization hospital (dominio MSGC, ejemplo)"
Description: "Patrón de identificación de hospitales dentro de un dominio SIHCE: system = {uri-dominio}/Organization, value = id local del hospital."
* name = "NamingSystemOrganizationHospitalMsgc"
* status = #active
* kind = #identifier
* date = "2026-08-26"
* publisher = "SIHCE Development Team"
* description = "Ejemplo para Hospital Central en dominio MSGC. Cada dominio publica su propio NamingSystem con el mismo patrón de URI."
* uniqueId[0].type = #uri
* uniqueId[0].value = "http://msgc.gcba.gob.ar/Organization"
* uniqueId[0].preferred = true
