Logical: ModificarSDMPersona
Parent: Element
Id: ModificarSDMPersona
Title: "Modelo lógico ModificarSDMPersona (FederadorBA)"
Description: "Actualización del SDM de una persona federada; documento inmutable."
* ^version = "1.2.0"
* ^status = #draft
* SDMActual 1..1 BackboneElement "SDM actual" "Datos vigentes en FederadorBA."
* SDMActual.tipoDocumento 1..1 string "Tipo de documento" "Ej. DNI."
* SDMActual.documentoIdentificatorio 1..1 string "Número de documento" "Valor del documento."
* SDMActual.sexo 1..1 string "Sexo" "Sexo administrativo."
* SDMActual.primerNombre 1..1 string "Primer nombre" "Primer nombre."
* SDMActual.segundoNombre 0..1 string "Segundo nombre" "Segundo nombre."
* SDMActual.primerApellido 1..1 string "Primer apellido" "Primer apellido."
* SDMActual.segundoApellido 0..1 string "Segundo apellido" "Segundo apellido."
* SDMActual.fechaNacimiento 1..1 date "Fecha de nacimiento" "AAAA-MM-DD."
* SDMActual.fechaDefuncion 0..1 date "Fecha de defunción" "Si aplica."
* SDMNuevo 1..1 BackboneElement "SDM nuevo" "Valores deseados (sin documento)."
* SDMNuevo.sexo 1..1 string "Sexo" "Sexo actualizado."
* SDMNuevo.primerNombre 1..1 string "Primer nombre" "Nombre actualizado."
* SDMNuevo.segundoNombre 0..1 string "Segundo nombre" "Segundo nombre actualizado."
* SDMNuevo.primerApellido 1..1 string "Primer apellido" "Apellido actualizado."
* SDMNuevo.segundoApellido 0..1 string "Segundo apellido" "Segundo apellido actualizado."
* SDMNuevo.fechaNacimiento 1..1 date "Fecha de nacimiento" "Fecha actualizada."
* SDMNuevo.fechaDefuncion 0..1 date "Fecha de defunción" "Si aplica."
* DatosDominio 1..1 BackboneElement "Dominio solicitante" "Dominio que solicita el cambio."
* DatosDominio.idDominio 1..1 uri "URI del dominio" "Identificador del dominio."
* DatosDominio.idLocalPersona 1..1 string "Id local" "Identificador local en el dominio."
* DatosRespuesta 0..1 BackboneElement "Respuesta" "Resultado de la operación."
* DatosRespuesta.mensaje 1..1 string "Mensaje" "Mensaje informativo o de error."
