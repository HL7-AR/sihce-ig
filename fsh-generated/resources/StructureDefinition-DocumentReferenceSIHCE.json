  "publisher": "SIHCE Development Team",
  "description": "Índice federado de documentos clínicos. En POST el dominio emisor registra metadatos con la URL real en content.attachment.url. En GET (consulta ITI-67) SIHCE devuelve URLs del Proxy Central (/Proxy/Binary/{id}). La descarga (ITI-68) es GET al proxy: SIHCE revalida Consent (MCC) y hace proxy pass sincrónico al custodio.",
  "jurisdiction": [
    {
      "coding": [
        {
          "code": "AR",
          "system": "urn:iso:std:iso:3166",
          "display": "Argentina"
        }
      ]
    }
  ],
  "fhirVersion": "5.0.0",
  "kind": "resource",
  "abstract": false,
  "type": "DocumentReference",
  "baseDefinition": "http://hl7.org/fhir/StructureDefinition/DocumentReference",
  "derivation": "constraint",
  "differential": {
    "element": [
      {
        "id": "DocumentReference.identifier",
        "path": "DocumentReference.identifier",
        "short": "Identificador del documento en el dominio emisor",
        "min": 1,
        "mustSupport": true
      },
      {
        "id": "DocumentReference.identifier.system",
        "path": "DocumentReference.identifier.system",
        "short": "URI del dominio o NamingSystem del documento (definido por el dominio)",
        "min": 1,
        "mustSupport": true
      },
      {
        "id": "DocumentReference.identifier.value",
